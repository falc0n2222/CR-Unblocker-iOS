{
  "log": { "level": "warn" },
  "dns": {
    "servers": [
      { "type": "local", "tag": "local" },
      {
        "type": "fakeip",
        "tag": "fake",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "domain": [
          "static.crunchyroll.com",
          "metrics.crunchyroll.com",
          "eec.crunchyroll.com",
		  "beta-api.crunchyroll.com",
          "cr-play-service.prd.crunchyroll.com",
		  "imgsrv.crunchyroll.com"
        ],
        "server": "local"
      },
      {
        "domain_suffix": ["crunchyroll.com"],
        "server": "fake"
      }
    ],
    "final": "local"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": ["172.19.0.1/30", "fdfe:dcba:9876::1/126"],
      "auto_route": true
    }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct" },
    {
      "type": "socks",
      "tag": "us-proxy",
      "server": "us.community-proxy.meganeko.dev",
      "server_port": 5445,
      "version": "5",
      "username": "GeoBypassCommunity-US",
      "password": "UseWithRespect"
    }
  ],
  "route": {
    "rules": [
      { "port": 53, "action": "hijack-dns" },
      {
        "network": "udp",
        "port": 443,
        "domain_suffix": ["crunchyroll.com"],
        "action": "reject"
      },
      {
        "domain_suffix": ["crunchyroll.com"],
        "outbound": "us-proxy"
      }
    ],
    "final": "direct",
    "default_domain_resolver": "local",
    "auto_detect_interface": true
  },
  "experimental": {
    "cache_file": { "enabled": true, "store_fakeip": true }
  }
}
